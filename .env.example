# Copy to .env.local and fill in. Never commit real secrets.

# --- Database (Supabase Postgres) ---
# Supabase Dashboard > Project Settings > Database > Connection string.
# Use the "Transaction pooler" URI (port 6543). prepare:false is set in code.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres"

# --- Supabase project ---
# Storage (logo uploads) in Phase 1; magic-link auth in Phase 2.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service role key — server only. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Public site URL (canonical links, Open Graph, sitemap, checkout return_url) ---
# In production this MUST be the real domain (e.g. https://rankly-tawny-eight.vercel.app),
# NOT localhost — the Dodo mandate checkout redirects the buyer back here after paying.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Billing: Dodo Payments ---
# Dashboard: https://app.dodopayments.com  (use the LIVE / production environment,
# not test, once you're charging real cards).
# Secret API key — server only. Dodo Dashboard > Developer > API Keys.
DODO_PAYMENTS_API_KEY="dodo_live_..."
# Webhook signing secret. Generated by Dodo when you create the webhook endpoint
# (Dashboard > Developer > Webhooks). Must match the value Dodo shows for THIS endpoint,
# or every webhook is rejected as an invalid signature.
DODO_PAYMENTS_WEBHOOK_KEY="whsec_..."
# The RECURRING product the on-demand mandate is created against (mandate_only checkout).
# Must be a subscription/recurring product — a one-time product is rejected (422).
DODO_PRODUCT_ID="pdt_..."
# "live_mode" for real charges, "test_mode" for the sandbox. Anything other than
# "test_mode" is treated as live (see lib/billing/dodo.ts).
DODO_PAYMENTS_ENVIRONMENT="live_mode"

# --- Cron / scheduled jobs ---
# Shared secret for the cron endpoints (daily billing + first-place accrual) and the
# temporary manual test endpoint. Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`.
# Any long random string. Endpoints refuse to run without it.
CRON_SECRET="a-long-random-string"

# --- Alerts (optional) ---
# If set, billing failures POST a JSON alert here (Slack/Discord/webhook URL). Optional.
ALERT_WEBHOOK_URL=""
